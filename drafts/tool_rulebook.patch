@@ -119,3 +119,29 @@ def guidance(request: str, tools: Iterable) -> list[str]:
 
 def guide_block(request: str, tools: Iterable) -> str:
     return "\n".join(guidance(request, tools))
+
+
+# How the product's tools divide the work, shown on every action turn whatever the wording: one line
+# per kind of tool, kept when the catalog offers the tools it names. Advice for the model like the
+# notes above; it decides every call.
+TOOL_RULES = (
+    ({"list_schedules"}, "Which workflows run on a schedule or are set to run, when, how often and how many runs they have logged: list_schedules. list_workflows lists the saved workflows themselves."),
+    ({"create_workflow"}, "Something the user wants to happen again and again on its own (every Friday, each morning, on a repeat): create_workflow, with the steps the user describes. Not an agent job and not a saved note."),
+    ({"list_workflows", "run_workflow"}, "Running a saved workflow now: list_workflows, then run_workflow with the name exactly as listed."),
+    ({"execute_agent_job"}, "A piece of work the user wants carried out now, once (start it, kick it off, go ahead and do it, summarise this file): execute_agent_job with the task in the user's words. list_agent_jobs only shows jobs already running."),
+    ({"artifacts"}, "Something the user wants to see rendered or use on screen (a page, a game, an app, a mock-up, an interactive chart): artifacts. create_image is for a still picture."),
+    ({"edit_image"}, "A change to a picture made earlier in this conversation: edit_image on that picture, not a new image."),
+    ({"discover_capabilities"}, "What Ditto can do, what kinds of things to ask it, or which options a setting has: discover_capabilities, and answer from what it lists."),
+    ({"search_tools"}, "Which of your tools fits a job: search_tools, answer from what it finds and run nothing else."),
+    ({"discover_capabilities", "set_chat_font"}, "A setting value named loosely, misspelled or with -ish (a font, an accent colour, a theme): list the options with discover_capabilities, then call the setter with the listed option closest to what the user wrote. Both calls are needed."),
+    ({"update_memory"}, "A fact in one of the user's notes has changed: update_memory on that note's id, the content naming the thing as the user calls it and its new value (the handoff is Tuesday), not only the change (moved to Tuesday)."),
+    ({"search_web"}, "Something current in the world: one search_web, then answer with the figure as the result writes it. Search again only if the first search returned nothing useful."),
+    ({"search_web", "gmail_send"}, "A live figure to pass on to someone: search_web for the figure first, then gmail_send it to the address the user's records give for that person."),
+    ({"calendar_create_event", "calendar_search_events"}, "Putting a named event on the calendar: if a note says it is booked already, calendar_search_events finds it and nothing is created; if a note says its date is undecided, ask; otherwise calendar_create_event right away on the day given. If the request only says 'that' or 'it', ask what to add."),
+)
+
+
+def tool_rules(tools: Iterable) -> str:
+    offered = set(tool_names(tools))
+    lines = [text for needs, text in TOOL_RULES if needs <= offered]
+    return "How the tools divide the work:\n- " + "\n- ".join(lines) if lines else ""
